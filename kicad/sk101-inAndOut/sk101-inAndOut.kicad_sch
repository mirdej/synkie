	(text "Standard video: 0V = Black, 0.714V = White\nSynkie video:   0V = Black, 1.000V = White -> 1.4 x Standard"
		(exclude_from_sim no)
		(at 179.705 118.11 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4a5ea40c-89c2-4623-a947-95063ffe5838")
	)
	(text "per new design Genlock signal internally has a gain of 1.48 (same as siff-signal)\nso that resynchers can multiplex the signals 1:1, \notherwise synctip and colorburst would not have the correct amplitude\nkeep that in mind if you want to provide genlock to the outside world!"
		(exclude_from_sim no)
		(at 139.065 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "64fb4bd6-d1ec-46d6-9eb9-dee6bc104c3a")
	)
